DATABASE_URL=postgresql://bailio:bailio@localhost:5432/bailio
CLIENT_URL=http://localhost:5173
# Origines supplémentaires autorisées, séparées par des virgules (ex. https://www.bailio.fr)
CORS_ORIGINS=
# Emails : Service Mail Infomaniak (sans SMTP, les emails sont affichés dans les logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bailio <bonjour@bailio.fr>

# Services tiers (src/providers/index.ts) : vides = mode simulé, rien ne sort du serveur.
# Choisir un fournisseur ET renseigner toutes ses variables ; /admin/providers dit ce qui manque.
BANK_PROVIDER=          # powens | bridge (lecture seule)
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
ESIGN_PROVIDER=         # vide = signature maison ; docusign | yousign
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_PRIVATE_KEY=
YOUSIGN_API_KEY=
REGISTERED_PROVIDER=    # ar24
AR24_TOKEN=
AR24_PRIVATE_KEY=
PAYMENT_PROVIDER=       # stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
LISTING_PROVIDER=       # aucun possible pour un particulier (voir docs/strategie/fournisseurs-2026-11.md)
