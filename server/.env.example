DATABASE_URL=postgresql://bailio:bailio@localhost:5432/bailio
CLIENT_URL=http://localhost:5173
# Origines supplémentaires autorisées, séparées par des virgules (ex. https://www.bailio.fr)
CORS_ORIGINS=
# Emails transactionnels (sans clé : les emails sont affichés dans les logs)
RESEND_API_KEY=
EMAIL_FROM=Bailio <bonjour@bailio.fr>
# Connexion Google (facultatif)
GOOGLE_CLIENT_ID=
# Lecture des baux importés par l'IA (facultatif)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
