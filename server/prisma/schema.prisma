// Bailio — schéma de données
// Montants en centimes (Int). Aucune suppression de colonne sans migration relue.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeaseType {
  UNFURNISHED // location vide
  FURNISHED // location meublée
}

enum LeaseStatus {
  ACTIVE
  ENDED
  IMPORTED // bail déjà signé, importé par le propriétaire
  DRAFT // bail en préparation dans l'espace
}

enum DocumentKind {
  LEASE // bail généré par Bailio
  LEASE_IMPORTED // bail signé importé (photo ou PDF)
  RECEIPT // quittance
  PARTIAL_RECEIPT // reçu de paiement partiel
  RENT_NOTICE // avis d'échéance
  GUARANTEE // acte de caution
  INVENTORY // état des lieux
  INVOICE // facture (travaux, entretien)
  DIAGNOSTIC // diagnostic technique
  LETTER // courrier (révision, relance, congé, régularisation, restitution)
  OTHER
}

enum ReminderType {
  RENT_RECEIPT // quittance du mois
  INSURANCE // attestation d'assurance du locataire
  RENT_REVISION // révision annuelle du loyer
  LEASE_END // fin de bail
  INVENTORY_ENTRY // état des lieux d'entrée
  CHARGES_REGULARIZATION // régularisation annuelle des charges
}

enum ReminderStatus {
  TODO
  DONE
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  firstName       String?
  lastName        String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  followUpSince   DateTime? // « Activer le suivi » : emails de rappel actifs
  // Profil du bailleur (domain/contract.ts, landlordProfileSchema) : repris dans tous les documents.
  profile         Json      @default("{}")
  notifyWeekly    Boolean   @default(true) // récapitulatif du lundi
  notifyUrgent    Boolean   @default(true) // alertes urgentes (loyer en retard…)
  createdAt       DateTime  @default(now())

  sessions   Session[]
  properties Property[]
  leases     Lease[]
  documents  Document[]
  reminders  Reminder[]
  drafts     Draft[]
  tenants     Tenant[]
  payments    Payment[]
  expenses    Expense[]
  inventories Inventory[]
  files       FileBlob[]
  signatures  SignatureRequest[]
  actionCodes ActionCode[]
  candidates  Candidate[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  // Journal des connexions (« Mon compte ») et expiration après inactivité.
  lastSeenAt DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
}

// Code à usage unique envoyé par email avant une action sensible (export des données, suppression du compte).
model ActionCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // EXPORT, DELETE
  purpose   String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Lien magique : connexion, ou rattachement d'un brouillon à un compte existant.
model LoginToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  draftId   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// Brouillon du tunnel, commencé sans compte. Le token (en clair) reste chez le client.
model Draft {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  data        Json      @default("{}")
  step        String    @default("type")
  resumeEmail String?
  // « J'ai déjà un bail signé » : fichier d'origine, conservé jusqu'à la création du compte
  importFile  Bytes?
  importMime  String?
  importName  String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  leaseId     String?   @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
}

model Property {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address      String // libellé complet
  postalCode   String?
  city         String?
  inseeCode    String?
  banId        String?
  surface      Float?
  rooms        Int?
  dpeClass     String?
  dpeNumber    String?
  label        String? // nom court : « Studio rue Foch »
  // Lien public de candidature (/candidature/:code), null si désactivé
  applyCode    String?  @unique
  // Fiche complète du logement (domain/contract.ts, propertyFileSchema)
  data         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  leases     Lease[]
  tenants    Tenant[]
  expenses   Expense[]
  documents  Document[]
  candidates Candidate[]

  @@index([userId])
}

/// Candidature reçue par le lien public d'un logement. Effacée quand le candidat devient locataire,
/// ou trois mois après réception (données personnelles gardées le moins longtemps possible).
model Candidate {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status     String   @default("NEW") // NEW, SHORTLIST, REJECTED
  data       Json
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([userId])
}

// Locataire (et son garant) : fiche complète (domain/contract.ts, tenantFileSchema).
model Tenant {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  data       Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  documents Document[]

  @@index([userId])
}

model Lease {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type            LeaseType
  status          LeaseStatus @default(ACTIVE)
  startDate       DateTime    @db.Date
  durationMonths  Int
  endDate         DateTime    @db.Date
  rentCents       Int
  chargesCents    Int
  depositCents    Int
  paymentDay      Int         @default(5)
  // Bail créé dans l'espace : { terms } (domain/contract.ts). Bail du tunnel : copie des réponses.
  data            Json
  // Locataires signataires (fiches Tenant) ; vide pour les baux créés par l'ancien tunnel.
  tenantIds       String[]    @default([])
  signedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  documents   Document[]
  reminders   Reminder[]
  payments    Payment[]
  inventories Inventory[]
  signatures  SignatureRequest[]

  @@index([userId])
}

// Chaque version d'un document est conservée, jamais écrasée.
model Document {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseId     String?
  lease       Lease?       @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // GENERATED (par Bailio) ou UPLOADED (ajouté par le propriétaire)
  origin      String       @default("GENERATED")
  // Période concernée (quittance : « 2026-09 »), ou autre repère
  period      String?
  meta        Json?
  kind        DocumentKind
  version     Int          @default(1)
  title       String
  mimeType    String
  sha256      String
  sizeBytes   Int
  // Bail généré : snapshot des données (le PDF est re-rendu à l'identique). Bail importé : le fichier d'origine.
  snapshot    Json?
  file        Bytes?
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([leaseId, kind])
  @@index([propertyId])
}

// Loyer reçu pour un mois : complet → quittance, partiel → reçu (art. 21).
model Payment {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseId      String
  lease        Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  period       String // AAAA-MM
  amountCents  Int
  receivedAt   DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([leaseId, period])
  @@index([userId, period])
}

// Dépense d'un logement : travaux, entretien, impôt, copropriété…
model Expense {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  vendor           String
  description      String?
  category         String // REPAIR, MAINTENANCE, TAX, COPRO, INSURANCE, OTHER
  amountCents      Int
  recoverableCents Int      @default(0) // part récupérable sur le locataire
  chargeTo         String   @default("OWNER") // OWNER ou TENANT
  status           String   @default("OK") // TO_VERIFY (lue automatiquement) ou OK
  date             DateTime @db.Date
  documentId       String?
  createdAt        DateTime @default(now())

  @@index([userId, date])
}

// État des lieux d'entrée ou de sortie (décret n° 2016-382).
model Inventory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseId   String
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  kind      String // ENTRY ou EXIT
  status    String   @default("DRAFT") // DRAFT ou SIGNED
  date      DateTime?
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([leaseId])
}

// Fichier déposé (photo d'état des lieux, justificatif, diagnostic, facture) : visible seulement par son propriétaire.
model FileBlob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
}

model Reminder {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseId   String
  lease     Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type      ReminderType
  dueDate   DateTime       @db.Date
  status    ReminderStatus @default(TODO)
  emailedAt DateTime?
  doneAt    DateTime?
  // « Me le rappeler plus tard » : masqué jusqu'à cette date
  snoozedUntil DateTime?

  @@unique([leaseId, type, dueDate])
  @@index([userId, dueDate])
}

// Signature électronique d'un bail (Code civil, art. 1366 et 1367 ; règlement eIDAS) :
// document figé (empreinte SHA-256), chaque signataire identifié par un lien personnel
// et un code reçu par email, horodatage, adresse IP et appareil conservés comme preuve.
model SignatureRequest {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseId      String
  lease        Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  // PENDING, COMPLETED, CANCELLED
  status       String    @default("PENDING")
  // Contrat figé au lancement : le PDF signé est rendu à l'identique depuis ces données.
  snapshot     Json
  // Empreintes SHA-256 des documents présentés : { lease, guarantees: { [index]: hash } }
  hashes       Json
  // Document final (signatures + certificat), une fois tous les signataires passés.
  signedDocumentId String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  signers      Signer[]

  @@index([leaseId])
}

model Signer {
  id           String    @id @default(uuid())
  requestId    String
  request      SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // LANDLORD, TENANT, GUARANTOR
  role         String
  // Rang du locataire ou du garant dans le contrat figé
  position     Int       @default(0)
  name         String
  email        String
  tokenHash    String    @unique
  // Le lien personnel expire : un nouveau est envoyé sur demande (« Renvoyer le lien »).
  tokenExpiresAt DateTime?
  codeHash     String?
  codeExpiresAt DateTime?
  codeAttempts Int       @default(0)
  codeVerifiedAt DateTime?
  // Mention recopiée (« Lu et approuvé », ou mention de l'article 2297 pour le garant)
  mention      String?
  image        String?
  signedAt     DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([requestId])
}
