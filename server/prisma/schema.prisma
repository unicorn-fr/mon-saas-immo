// Bailio — schéma de données
// Montants en centimes (Int). Aucune suppression de colonne sans migration relue.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeaseType {
  UNFURNISHED // location vide
  FURNISHED // location meublée
}

enum LeaseStatus {
  ACTIVE
  ENDED
  IMPORTED // bail déjà signé, importé par le propriétaire
}

enum DocumentKind {
  LEASE // bail généré par Bailio
  LEASE_IMPORTED // bail signé importé (photo ou PDF)
}

enum ReminderType {
  RENT_RECEIPT // quittance du mois
  INSURANCE // attestation d'assurance du locataire
  RENT_REVISION // révision annuelle du loyer
  LEASE_END // fin de bail
  INVENTORY_ENTRY // état des lieux d'entrée
}

enum ReminderStatus {
  TODO
  DONE
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  firstName       String?
  lastName        String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  followUpSince   DateTime? // « Activer le suivi » : emails de rappel actifs
  createdAt       DateTime  @default(now())

  sessions   Session[]
  properties Property[]
  leases     Lease[]
  documents  Document[]
  reminders  Reminder[]
  drafts     Draft[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Lien magique : connexion, ou rattachement d'un brouillon à un compte existant.
model LoginToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  draftId   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// Brouillon du tunnel, commencé sans compte. Le token (en clair) reste chez le client.
model Draft {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  data        Json      @default("{}")
  step        String    @default("type")
  resumeEmail String?
  // « J'ai déjà un bail signé » : fichier d'origine, conservé jusqu'à la création du compte
  importFile  Bytes?
  importMime  String?
  importName  String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  leaseId     String?   @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
}

model Property {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address      String // libellé complet
  postalCode   String?
  city         String?
  inseeCode    String?
  banId        String?
  surface      Float?
  rooms        Int?
  dpeClass     String?
  dpeNumber    String?
  createdAt    DateTime @default(now())

  leases Lease[]

  @@index([userId])
}

model Lease {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type            LeaseType
  status          LeaseStatus @default(ACTIVE)
  startDate       DateTime    @db.Date
  durationMonths  Int
  endDate         DateTime    @db.Date
  rentCents       Int
  chargesCents    Int
  depositCents    Int
  paymentDay      Int         @default(5)
  // Copie complète des réponses du tunnel (bailleur, locataires, garant…) : sert à régénérer le bail à l'identique.
  data            Json
  createdAt       DateTime    @default(now())

  documents Document[]
  reminders Reminder[]

  @@index([userId])
}

// Chaque version d'un document est conservée, jamais écrasée.
model Document {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseId     String?
  lease       Lease?       @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  kind        DocumentKind
  version     Int          @default(1)
  title       String
  mimeType    String
  sha256      String
  sizeBytes   Int
  // Bail généré : snapshot des données (le PDF est re-rendu à l'identique). Bail importé : le fichier d'origine.
  snapshot    Json?
  file        Bytes?
  createdAt   DateTime     @default(now())

  @@unique([leaseId, kind, version])
  @@index([userId])
}

model Reminder {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseId   String
  lease     Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type      ReminderType
  dueDate   DateTime       @db.Date
  status    ReminderStatus @default(TODO)
  emailedAt DateTime?
  doneAt    DateTime?

  @@unique([leaseId, type, dueDate])
  @@index([userId, dueDate])
}
