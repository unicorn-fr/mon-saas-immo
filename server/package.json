{
  "name": "@bailio/server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "test": "tsx --test src/domain/*.test.ts src/services/import/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.12",
    "react": "^19.3.0",
    "resend": "^6.30.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
