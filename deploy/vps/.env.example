# ── À copier en .env (cp .env.example .env) puis compléter. Ne jamais committer .env. ──

# Nom de domaine de l'API (enregistrements A et AAAA « api » dans la zone DNS de bailio.eu, chez Infomaniak)
API_DOMAIN=api.bailio.eu

# Mot de passe de la base : généré automatiquement par install.sh
POSTGRES_PASSWORD=

# Adresse du site dans les liens des emails
CLIENT_URL=https://bailio.fr

# Site servi par ce serveur : laisser vide tant que le site est sur Vercel (bailio.fr).
# Le jour où bailio.fr pointe vers ce serveur (A/AAAA « @ » et « www ») :
#   SITE_DOMAIN=bailio.fr
#   SITE_REDIRECT_DOMAINS=www.bailio.fr, bailio.eu, www.bailio.eu
#   SITE_URL=https://bailio.fr
SITE_DOMAIN=
SITE_REDIRECT_DOMAINS=
SITE_URL=https://bailio.fr

# Emails : Resend (recommandé) ou SMTP
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bailio <contact@bailio.fr>
RESEND_API_KEY=

# Copie des sauvegardes HORS du serveur (fortement conseillé), chiffrée avant l'envoi.
# Stockage compatible S3 : Infomaniak Swiss Backup (S3), Swiss Object Storage, Scaleway, OVH…
# Sans ces valeurs, la sauvegarde reste uniquement sur ce serveur.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Phrase secrète de chiffrement (longue, à noter AILLEURS que sur le serveur : sans elle, pas de restauration).
# Générer :  openssl rand -base64 32
BACKUP_PASSPHRASE=
