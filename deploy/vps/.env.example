# ── À copier en .env (cp .env.example .env) puis compléter. Ne jamais committer .env. ──

# Nom de domaine de l'API (enregistrements A et AAAA « api » dans la zone DNS de bailio.eu, chez Infomaniak)
API_DOMAIN=api.bailio.eu

# Mot de passe de la base : généré automatiquement par install.sh
POSTGRES_PASSWORD=

# Adresse du site dans les liens des emails
CLIENT_URL=https://bailio.fr

# Site servi par ce serveur : laisser vide tant que le site est sur Vercel (bailio.fr).
# Le jour où bailio.fr pointe vers ce serveur (A/AAAA « @ » et « www ») :
#   SITE_DOMAIN=bailio.fr
#   SITE_REDIRECT_DOMAINS=www.bailio.fr, bailio.eu, www.bailio.eu
#   SITE_URL=https://bailio.fr
SITE_DOMAIN=
SITE_REDIRECT_DOMAINS=
SITE_URL=https://bailio.fr

# Emails : messagerie Ionos de bailio.fr (SMTP authentifié). EMAIL_FROM doit être l'adresse de SMTP_USER (ou un de ses alias).
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bailio <contact@bailio.fr>

# Copie des sauvegardes HORS du serveur (fortement conseillé), chiffrée avant l'envoi.
# Sans copie hors serveur configurée, la sauvegarde reste uniquement sur ce serveur.
#
# Choix A — kDrive Infomaniak (WebDAV) : le plus simple si vous avez déjà un kDrive.
#   BACKUP_KDRIVE_URL  : https://<ID_KDRIVE>.connect.kdrive.infomaniak.com/<ID_KDRIVE>
#   BACKUP_KDRIVE_USER : votre identifiant Infomaniak (adresse email de connexion)
#   BACKUP_KDRIVE_PASS : un MOT DE PASSE D'APPLICATION dédié (Manager → Mon profil → Sécurité),
#                        jamais le mot de passe principal du compte. Révocable seul.
BACKUP_KDRIVE_URL=
BACKUP_KDRIVE_USER=
BACKUP_KDRIVE_PASS=
#
# Choix B — stockage compatible S3 (Scaleway, OVH, Swiss Object Storage…), utilisé seulement
# si les variables kDrive ci-dessus sont vides.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
#
# Phrase secrète de chiffrement (longue, à noter AILLEURS que sur le serveur : sans elle, pas de restauration).
# Générer :  openssl rand -base64 32
BACKUP_PASSPHRASE=
