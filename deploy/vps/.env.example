# ── À copier en .env (cp .env.example .env) puis compléter. Ne jamais committer .env. ──

# Nom de domaine de l'API (enregistrements A et AAAA « api » dans la zone DNS de bailio.eu, chez Infomaniak)
API_DOMAIN=api.bailio.eu

# Mot de passe de la base : généré automatiquement par install.sh
POSTGRES_PASSWORD=

# Adresse principale du site, servi par ce serveur (enregistrements A « @ » et « www » vers l'IP du serveur)
SITE_DOMAIN=bailio.eu
# Adresses qui redirigent vers le site, séparées par des virgules. Quand bailio.fr sera récupéré chez Ionos :
# SITE_REDIRECT_DOMAINS=www.bailio.eu, bailio.fr, www.bailio.fr
SITE_REDIRECT_DOMAINS=www.bailio.eu

# Adresse du site dans les liens des emails (même valeur que SITE_DOMAIN, avec https://)
CLIENT_URL=https://bailio.eu

# Emails : Resend (recommandé) ou SMTP
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bailio <contact@bailio.fr>
RESEND_API_KEY=
