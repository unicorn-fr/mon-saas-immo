# Certificats HTTPS Let's Encrypt obtenus et renouvelés automatiquement par Caddy.
# Les domaines viennent du fichier .env (SITE_DOMAIN, SITE_REDIRECT_DOMAINS, API_DOMAIN).

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Le site : fichiers statiques + /api relayé vers l'API (même adresse, pas d'appel vers un autre domaine).
{$SITE_DOMAIN} {
	import securite
	encode zstd gzip
	request_body /api/* {
		max_size 160MB
	}
	header {
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy api:5000 {
			# Visiteur direct : son adresse réelle (une valeur envoyée par le navigateur est écrasée).
			header_up X-Original-Forwarded-For {remote_host}
		}
	}
	handle /health {
		reverse_proxy api:5000
	}
	# Fichiers versionnés (nom unique à chaque mise en ligne) : gardés un an par le navigateur.
	# Un fichier absent répond 404 : le site recharge alors la page, jamais d'écran vide.
	handle /assets/* {
		root * /srv/site
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Pages : toujours revérifiées, pour que chaque visiteur ait la dernière version.
	handle {
		root * /srv/site
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Autres adresses du site (www, ancien domaine) : redirection définitive vers l'adresse principale.
{$SITE_REDIRECT_DOMAINS} {
	import securite
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# L'API seule : appelée par le site bailio.fr (relais Vercel de /api).
{$API_DOMAIN} {
	import securite
	encode zstd gzip
	request_body {
		max_size 160MB
	}
	reverse_proxy api:5000 {
		# Requêtes relayées par Vercel (site bailio.fr) : Vercel place l'IP du visiteur dans X-Forwarded-For.
		header_up X-Original-Forwarded-For {http.request.header.X-Forwarded-For}
	}
}
